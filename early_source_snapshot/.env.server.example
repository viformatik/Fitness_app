# Copy to a private file OUTSIDE your repository, fill locally, then upload via Supabase CLI.
# Never put GEMINI_API_KEY or service-role keys in Flutter dart-defines.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: your Supabase publishable key if the built-in legacy anon key is disabled.
# APP_PUBLIC_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
